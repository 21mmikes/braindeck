# ---------------------------------------------------------------
# Copy this file to ".env.local" and paste your real key below.
# NEVER commit .env.local to GitHub - it is already in .gitignore.
# Get a key at: https://console.anthropic.com  ->  API Keys
# ---------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Which Claude model writes your flashcards.
#  claude-sonnet-5            -> best quality, handles very long documents
#  claude-haiku-4-5-20251001  -> cheaper and faster, slightly simpler cards
ANTHROPIC_MODEL=claude-sonnet-5

# How many flashcards to aim for per document (10-100)
CARDS_PER_DOCUMENT=25
